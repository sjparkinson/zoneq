{
  "problemMatcher": [
    {
      "owner": "rustc",
      "pattern": [
        {
          "regexp": "^(?:\\x1B\\[[0-9;]*m)*(warning|error)(?:\\[(\\S+)\\])?(?:\\x1B\\[[0-9;]*m)*: (.*?)(?:\\x1B\\[[0-9;]*m)*$",
          "severity": 1,
          "code": 2,
          "message": 3
        },
        {
          "regexp": "^\\s*(?:\\x1B\\[[0-9;]*m)*-->\\s*(?:\\x1B\\[[0-9;]*m)*(\\S+):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    },
    {
      "owner": "rustfmt",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(Diff in (\\S+):(\\d+):)$",
          "message": 1,
          "file": 2,
          "line": 3
        }
      ]
    },
    {
      "owner": "rust-panic",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^thread '(.+?)'(?: \\(\\d+\\))? panicked at (\\S+):(\\d+):(\\d+):$",
          "code": 1,
          "file": 2,
          "line": 3,
          "column": 4
        },
        {
          "regexp": "^(.+)$",
          "message": 1
        }
      ]
    }
  ]
}
